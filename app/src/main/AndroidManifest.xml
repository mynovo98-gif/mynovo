<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="moe.shizuku.privileged.permission.POST_BINDER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ใช้เชื่อม socket localhost กับ InputServer (activate.sh) และจับคู่ ADB -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ใช้ค้นหา mDNS (พอร์ต pair/connect ของ Wireless debugging) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- แจ้งเตือนสำหรับพิมพ์โค้ด pair (Wireless activation) — Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- สิทธิ์สำหรับ Foreground Service (จำเป็นสำหรับ Android 16 เพื่อไม่ให้โดนฆ่าแอป) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/app_b"
        android:label="Blue Mouse Pro"
        android:resizeableActivity="true"
        android:roundIcon="@drawable/app_b"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== เพิ่มใหม่: ระบบ Login / Register / Forgot Password (Firebase Auth) ===== -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />
        <!-- ===== จบส่วนที่เพิ่มใหม่ ===== -->

        <!-- หน้าจับคู่สำหรับโหมด DeX (เปิดเป็นหน้าต่างแยกข้างหน้าตั้งค่า) -->
        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|uiMode"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <!-- อัปเดต Service ระบุประเภท specialUse ให้รอดจากระบบจัดการแบตของ Android 16 -->
        <service
            android:name=".FloatingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Overlay tool for keymapping and touch simulation" />
        </service>

        <!-- กันปุ่ม Windows ไม่ให้ออกหน้าหลักขณะเล่นเกม -->
        <service
            android:name=".KeyBlockService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_block_service_config" />
        </service>

    </application>

</manifest>
